# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongo:27017/aurachat
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Tạo chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# Optional: create/promote the initial administrator on application startup.
# Never commit a real password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# ── Email (Forgot Password OTP) ───────────────────────────────────────────────
# Dùng Gmail: bật 2FA rồi tạo App Password tại myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── ImageKit ──────────────────────────────────────────────────────────────────
# Lấy tại: https://imagekit.io/dashboard → Developer Options
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

# ── Firebase ──────────────────────────────────────────────────────────────────
# Đường dẫn đến file serviceAccountKey.json
# Lấy tại: https://console.firebase.google.com → Project Settings → Service Accounts → Generate New Private Key
# Có thể dùng đường dẫn tương đối (src/main/resources/serviceAccountKey.json) hoặc tuyệt đối (/path/to/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=src/main/resources/serviceAccountKey.json
